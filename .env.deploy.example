# Cafe Maza - Unified Deploy Environment Template
# Copy this file to your secure environment manager and replace all placeholder values.
# Do not commit real secrets.

# ==================================================
# Core app
# ==================================================
NODE_ENV=production

# Public frontend URL(s) allowed by backend CORS (comma-separated if multiple)
FRONTEND_URL=https://your-frontend-domain.com

# ==================================================
# Backend server
# ==================================================
PORT=5000
PORT_AUTO_FALLBACK=false
LOG_LEVEL=info

# ==================================================
# Database + auth
# ==================================================
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/<db>?retryWrites=true&w=majority
JWT_SECRET=replace_with_high_entropy_secret_min_32_chars

# ==================================================
# Razorpay (required if online payment is enabled)
# ==================================================
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace_with_razorpay_secret

# ==================================================
# SMTP (optional: order email notifications)
# ==================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ORDER_NOTIFICATION_EMAIL=

# ==================================================
# WhatsApp / MSG91
# ==================================================
WHATSAPP_ADMIN_PHONE=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace_with_webhook_verify_token

MSG91_AUTH_KEY=replace_with_msg91_auth_key
MSG91_TEMPLATE_NAME=cafe_maza_otp
MSG91_INTEGRATED_NUMBER=replace_with_integrated_whatsapp_number
MSG91_OTP_LANGUAGE=en
MSG91_OTP_BUTTON_URL_PARAM=
MSG91_OTP_LENGTH=6
MSG91_OTP_EXPIRY_MINUTES=10
# Optional legacy MSG91 keys (keep if your account/workflow uses them)
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

MSG91_ORDER_LANGUAGE=en
MSG91_ORDER_PLACED_TEMPLATE=order_placed
MSG91_ORDER_ACCEPTED_TEMPLATE=order_accepted
MSG91_DELIVERY_ASSIGNED_TEMPLATE=delivery_assigned
MSG91_OUT_FOR_DELIVERY_TEMPLATE=out_for_delivery
MSG91_ORDER_DELIVERED_TEMPLATE=order_deliveredd
MSG91_ORDER_DELIVEREDD_TEMPLATE=order_deliveredd
MSG91_EVENT_DEDUPE_MINUTES=180
MSG91_ORDER_DELIVERED_DEDUPE_MINUTES=1440

# ==================================================
# Frontend (Next.js)
# ==================================================
NEXT_PUBLIC_SITE_URL=https://your-frontend-domain.com
NEXT_PUBLIC_API_BASE_URL=/backend
NEXT_PUBLIC_SOCKET_URL=https://your-backend-domain.com

# ==================================================
# Supabase
# ==================================================
# Public keys used by frontend + some backend scripts
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_supabase_anon_key
NEXT_PUBLIC_SUPABASE_MENU_BUCKET=menu-images

# Server-only keys
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
SUPABASE_SERVICE_KEY=replace_with_service_key_for_backend_scripts

# ==================================================
# Legacy OTP provider (optional / backward compatibility)
# ==================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
